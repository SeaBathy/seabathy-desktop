{
  "name": "seabathy-desktop",
  "productName": "SeaBathy Desktop",
  "version": "1.0.1",
  "description": "SeaBathy for Windows: survey depths, offline maps, sea conditions, tides, waypoints and route planning",
  "main": "src/main.js",
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "dist": "node build.mjs && electron-builder --win portable"
  },
  "build": {
    "appId": "au.opendepth.seabathy.desktop",
    "files": [
      "src/main.js",
      "src/preload.js",
      "src/index.html",
      "src/styles.css",
      "dist/renderer.js",
      "dist/maplibre-gl.css",
      "dist/maplibre-gl-worker.cjs",
      "!node_modules/better-sqlite3/deps/**",
      "!node_modules/better-sqlite3/src/**",
      "!node_modules/better-sqlite3/build/**",
      "!node_modules/better-sqlite3/binding.gyp",
      "!node_modules/better-sqlite3/prebuilds/darwin-*",
      "!node_modules/better-sqlite3/prebuilds/linux*",
      "!node_modules/better-sqlite3/prebuilds/win32-arm64.node",
      "!node_modules/node-addon-api/**"
    ],
    "win": {
      "target": "portable",
      "artifactName": "SeaBathy-Desktop-${version}.exe"
    },
    "directories": {
      "output": "release"
    },
    "compression": "maximum",
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*.node"
    ],
    "electronLanguages": [
      "en-US",
      "en-GB"
    ]
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "geotiff": "2.1.3",
    "maplibre-gl": "6.17.0",
    "proj4": "2.12.1",
    "three": "0.170.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
